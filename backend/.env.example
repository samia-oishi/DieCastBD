# Server
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
# Extra origins allowed for credentialed CORS (comma-separated), on top of CLIENT_URL.
# Leave blank locally. On a deployed backend, add http://localhost:5173 here to let a
# locally-run frontend talk to it, e.g. CORS_ORIGINS=http://localhost:5173
CORS_ORIGINS=

# MongoDB Atlas
MONGODB_URI=

# JWT / Cookies — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
COOKIE_SECRET=

# Vercel Cron auth — only needed when deploying the backend to Vercel serverless.
# Generate with the same command as the secrets above. Vercel sends it as a Bearer token.
CRON_SECRET=

# Firebase Admin SDK (service account)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Comma-separated emails auto-promoted to admin on first verified sign-in.
# The first entry is also the fallback recipient for order/contact
# notifications when Settings has no contact email.
ADMIN_EMAILS=

# Resend (transactional email)
RESEND_API_KEY=
EMAIL_FROM=

# bKash Merchant API (wired in Phase 8 — leave blank until then)
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_BASE_URL=

# Steadfast courier API (Settings -> API in the Steadfast merchant panel).
# The key and the secret are two DIFFERENT values. Leave blank to hide the
# courier controls in the admin.
STEADFAST_API_KEY=
STEADFAST_SECRET_KEY=
